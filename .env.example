# Everything here is optional. `make dev` needs no keys and never calls an LLM.
# These settings are only for `make agents` and `make live`.

# Option 1: a local Ollama model. Free, no account.
# AGENT_BACKEND=ollama
# OLLAMA_MODEL=qwen2.5:7b-instruct

# Option 2: the Anthropic API.
# ANTHROPIC_API_KEY=
